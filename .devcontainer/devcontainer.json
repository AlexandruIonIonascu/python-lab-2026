{
  "name": "Python \u2014 first two labs",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python --version && git --version",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.autoSave": "off",
        "editor.tabSize": 4
      }
    }
  }
}
